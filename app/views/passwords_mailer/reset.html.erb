<% content_for :preheader, "Choose a new password for your Good Sorcery account." %>

<%= email_heading "Reset your password" %>

<%= email_text "Someone asked to reset the password for your Good Sorcery account." %>

<%= email_button "Choose a new password", @url %>

<%= email_note "This link expires in #{distance_of_time_in_words(0, @user.password_reset_token_expires_in)}. If you didn't ask for this, you can ignore this email and your password stays the same." %>

<%= email_divider %>

<%= email_link_fallback @url %>
