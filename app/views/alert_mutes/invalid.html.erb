<% provide :title, "Link no longer works" %>

<h1 class="font-display text-[28px] leading-tight text-ink-50">This link no longer works</h1>
<p class="mt-2 text-[14px] text-ink-300">
  Mute links expire after <%= AlertMute::EXPIRES_IN.in_days.to_i %> days, and stop working if you leave the account or the app is deleted.
  Sign in to choose which emails you get.
</p>
<%= link_to "Open Notifications", notifications_path, class: "btn btn-primary w-full justify-center py-2.5 mt-6" %>
