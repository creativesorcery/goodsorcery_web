<%# Phones: two columns, hairlines from the 1px gaps; md and up: one row with dividers. -%>
<dl class="mt-7 grid grid-cols-2 md:grid-cols-5 max-md:gap-px max-md:bg-iris-500/10 max-md:overflow-hidden md:divide-x md:divide-iris-500/10 border border-iris-500/10 rounded-xl md:bg-paper-900/60 max-md:[&>div]:bg-paper-900 <%= 'rise rise-1' if animate %>">
  <div class="px-4 py-3">
    <dt class="text-[11px] uppercase tracking-[.16em] text-ink-400">Events</dt>
    <dd class="font-display text-[24px] text-ink-50 mt-0.5"><%= delimited(issue.events_count) %></dd>
  </div>
  <div class="px-4 py-3">
    <dt class="text-[11px] uppercase tracking-[.16em] text-ink-400">Users</dt>
    <dd class="font-display text-[24px] text-ink-50 mt-0.5"><%= delimited(issue.users_count) %></dd>
  </div>
  <div class="px-4 py-3">
    <dt class="text-[11px] uppercase tracking-[.16em] text-ink-400">First seen</dt>
    <dd class="text-[14px] text-ink-100 mt-2">
      <%= clock_label(issue.first_seen_at) %> <span class="text-ink-400">· <%= time_ago_compact(issue.first_seen_at) %></span>
    </dd>
  </div>
  <div class="px-4 py-3">
    <dt class="text-[11px] uppercase tracking-[.16em] text-ink-400">Last seen</dt>
    <dd class="text-[14px] text-ink-100 mt-2" title="<%= clock_label(issue.last_seen_at) %>"><%= time_ago_compact(issue.last_seen_at) %></dd>
  </div>
  <div class="px-4 py-3 min-w-0 max-md:col-span-2">
    <dt class="text-[11px] uppercase tracking-[.16em] text-ink-400">Fingerprint</dt>
    <dd class="text-[13px] mt-2 font-mono text-ink-300 truncate" title="<%= issue.fingerprint %>"><%= issue.fingerprint_label %></dd>
  </div>
</dl>
