<section class="panel p-5 <%= 'rise rise-2' if animate %>">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <h2 class="font-display text-[20px] text-ink-50">
      Occurrences <span class="font-sans text-[13px] text-ink-400"><%= delimited(chart.total) %> in the last <%= chart.period %></span>
    </h2>
    <nav class="segmented" aria-label="Chart period">
      <% IssueChart::PERIODS.each do |period| %>
        <%= link_to period, project_issue_chart_path(project, issue, period:), aria: { current: ("true" if period == chart.period) } %>
      <% end %>
    </nav>
  </div>

  <div class="relative mt-5">
    <div class="absolute inset-0 flex flex-col justify-between pointer-events-none" aria-hidden="true">
      <div class="border-t border-dashed border-paper-700"></div>
      <div class="border-t border-dashed border-paper-700"></div>
      <div class="border-t border-paper-600"></div>
    </div>
    <div class="relative overflow-hidden">
      <%= histogram_svg chart.values, color: issue_chart_color(issue), width: 860, height: 120, fluid: true,
            highlight_last: issue.new? || issue.regressed?, titles: chart.titles %>
    </div>
  </div>

  <div class="flex justify-between text-[11px] text-ink-400 font-mono mt-2">
    <% labels = chart.axis_labels %>
    <% labels.each_with_index do |label, index| %>
      <%# Phones keep every other label so they don't run together. -%>
      <span class="<%= 'max-sm:hidden' if index.odd? && index < labels.size - 1 %>"><%= label %></span>
    <% end %>
  </div>
</section>
