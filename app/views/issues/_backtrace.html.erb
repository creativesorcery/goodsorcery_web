<% show_framework = !backtrace.app_frames? %>
<section class="relative rise rise-3" data-controller="toggle clipboard">
  <div class="max-lg:relative flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-3">
    <h2 class="font-display text-[22px] text-ink-50">Backtrace</h2>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[12.5px] text-ink-300">
      <% if backtrace.framework_frame_count.positive? %>
        <button type="button" class="toggle flex items-center gap-2 whitespace-nowrap max-lg:min-h-10" aria-pressed="<%= show_framework %>"
                data-toggle-target="switch" data-action="toggle#flip">
          <span class="track"><span class="knob"></span></span>
          Show framework frames
        </button>
      <% end %>
      <details>
        <summary class="btn btn-sm">Raw</summary>
        <pre class="absolute left-0 right-0 top-12 max-lg:top-full max-lg:mt-3 z-10 max-h-[28rem] overflow-auto code-pane code-pane-body whitespace-pre shadow-[0_8px_24px_-12px_rgb(35_37_58/0.25)]"
             data-clipboard-target="source"><%= backtrace.raw %></pre>
      </details>
      <button type="button" class="btn btn-sm" data-action="clipboard#copy">Copy</button>
    </div>
  </div>

  <div class="panel overflow-hidden code">
    <% if backtrace.empty? %>
      <p class="px-4 py-6 font-sans text-[13px] text-ink-400">No backtrace was captured with this occurrence.</p>
    <% end %>
    <% backtrace.segments.each do |segment| %>
      <% if segment.app? %>
        <%= render "issues/app_frame", frame: segment.frame, expanded: segment.expanded? %>
      <% else %>
        <%= render "issues/framework_run", segment:, show: show_framework %>
      <% end %>
    <% end %>
  </div>
</section>
