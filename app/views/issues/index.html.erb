<% provide :title, "Issues · #{@project.name}" %>
<% provide :nav, "issues" %>
<% breadcrumb Current.account.name, projects_path %>
<% breadcrumb @project.name, project_issues_path(@project) %>
<% breadcrumb "Issues" %>
<%= render "live/issues_stream", project: @project %>

<div class="px-8 pt-8 pb-16 max-w-[1400px]">
  <%= turbo_frame_tag dom_id(@project, :summary), src: project_summary_path(@project, env: @summary.environment), complete: true do %>
    <%= render "projects/summaries/summary", summary: @summary %>
  <% end %>

  <div data-controller="bulk-selection">
    <section class="mt-8 rise rise-2">
      <%= render "issues/filter_bar", project: @project, list: @list %>
      <%= render "issues/tabs", project: @project, list: @list %>
    </section>

    <section id="<%= dom_id(@project, :issues) %>" class="panel mt-4 overflow-hidden rise rise-3" aria-label="Issues">
      <div class="<%= IssuesHelper::ROW_GRID %> px-5 py-2.5 text-[11px] uppercase tracking-[.16em] text-ink-400/80 border-b border-paper-700 bg-paper-850/60">
        <input type="checkbox" class="accent-iris-500" aria-label="Select all issues on screen"
               data-bulk-selection-target="all" data-action="bulk-selection#toggleAll">
        <span>Issue</span><span>Last 24h</span><span class="text-right">Events</span><span class="text-right">Users</span><span>Seen</span><span></span>
      </div>

      <% if @list.default_state? %>
        <%= render "live/new_issues", project: @project %>
      <% end %>

      <% if @list.empty? %>
        <%= render "issues/empty", project: @project, list: @list %>
      <% else %>
        <%= render "issues/rows", list: @list %>
        <%= render "issues/more", list: @list %>
      <% end %>
    </section>

    <%= render "issues/bulk_bar", project: @project, list: @list, members: @members %>
  </div>
</div>
