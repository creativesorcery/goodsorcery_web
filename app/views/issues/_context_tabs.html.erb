<%# Request / Params / Headers / Session / Job / Environment. Values are already
    scrubbed at ingest; "[FILTERED]" renders muted. An error raised in a job
    outside any request opens on the Job tab. %>
<% selected = initial_context_tab(occurrence) %>
<section class="rise rise-5" data-controller="tabs">
  <div class="tab-strip gap-6 border-b border-paper-700" role="tablist" aria-label="Occurrence context">
    <% IssueContextHelper::TABS.each do |id, label| %>
      <button type="button" class="tab" role="tab" id="context-tab-<%= id %>" aria-selected="<%= id == selected %>"
              aria-controls="context-<%= id %>" data-tabs-target="tab" data-action="tabs#select"><%= label %></button>
    <% end %>
  </div>

  <div class="panel mt-4 p-4 sm:p-5">
    <%= context_panel "request", selected do %>
      <%= render "issues/context_rows", rows: request_rows(occurrence), empty: "No request was captured with this occurrence." %>
    <% end %>

    <%= context_panel "params", selected do %>
      <%= render "issues/context_json", value: occurrence.params, empty: "No params were captured." %>
    <% end %>

    <%= context_panel "headers", selected do %>
      <%= render "issues/context_pairs", pairs: occurrence.headers, empty: "No headers were captured." %>
    <% end %>

    <%= context_panel "session", selected do %>
      <%= render "issues/context_json", value: occurrence.session_data, empty: "No session was captured." %>
    <% end %>

    <%= context_panel "job", selected do %>
      <% if occurrence.job.any? %>
        <%= render "issues/context_rows", rows: job_rows(occurrence), empty: "No job details were captured." %>
        <div class="mt-5 mb-2 text-[11px] uppercase tracking-[.16em] text-ink-400">Arguments</div>
        <%= render "issues/context_json", value: job_arguments(occurrence), empty: "No arguments were captured." %>
      <% else %>
        <p class="text-[13px] text-ink-400">No job was captured with this occurrence.</p>
      <% end %>
    <% end %>

    <%= context_panel "environment", selected do %>
      <%= render "issues/context_pairs", pairs: flatten_context(occurrence.context), empty: "No environment was captured." %>
    <% end %>
  </div>
</section>
