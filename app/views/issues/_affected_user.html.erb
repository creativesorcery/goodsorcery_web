<% user = occurrence&.user || {} %>
<div class="panel p-4 rise rise-3">
  <div class="text-[11px] uppercase tracking-[.18em] text-ink-400">Affected user</div>
  <% if user.any? %>
    <div class="flex items-center gap-3 mt-3">
      <span class="w-10 h-10 shrink-0 rounded-full bg-mint-100 grid place-items-center text-ink-50 font-display text-[16px]" aria-hidden="true"><%= affected_user_name(user).first.upcase %></span>
      <div class="leading-tight min-w-0">
        <div class="text-[14px] text-ink-50 truncate"><%= affected_user_name(user) %></div>
        <div class="text-[12px] text-ink-400 font-mono truncate"><%= affected_user_identity(user) %></div>
      </div>
    </div>
    <% if occurrence.user_digest.present? %>
      <div class="mt-3 text-[12px] text-ink-400">
        Hit this <span class="text-ink-100"><%= affected_user_hits(issue, occurrence) %>×</span> ·
        <%= link_to "all their errors", project_issues_path(project, q: "user:#{occurrence.user_digest}"),
              class: "text-iris-300 hover:underline", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  <% else %>
    <p class="mt-3 text-[12.5px] text-ink-400">No user was attached to this occurrence.</p>
  <% end %>
</div>
