<%# A run of consecutive framework/gem frames, folded until "Show framework frames" is on. %>
<%= tag.button type: "button", hidden: show, data: { toggle_target: "collapsed", action: "toggle#flip" },
      class: "w-full px-4 py-2 border-b border-paper-700/70 text-ink-400 font-sans text-[12px] flex items-center gap-2 bg-paper-900/50 text-left hover:text-ink-200" do %>
  <span class="w-6 border-t border-dashed border-paper-600" aria-hidden="true"></span>
  <%= pluralize(segment.size, "framework frame") %> hidden
  <% if segment.gem_names.any? %><span class="font-mono">(<%= segment.gem_summary %>)</span><% end %>
<% end %>
<%= tag.div hidden: !show, data: { toggle_target: "expanded" } do %>
  <% segment.frames.each do |frame| %>
    <div class="flex items-center gap-3 px-4 py-2 border-b border-paper-700/70 text-ink-400">
      <% if frame.gem_name %>
        <span class="shrink-0 text-[11px] font-mono border border-paper-600 rounded px-1.5 py-0.5"><%= frame.gem_name %></span>
      <% else %>
        <span class="shrink-0 text-[10px] uppercase tracking-[.18em] font-sans border border-paper-600 rounded px-1.5 py-0.5">lib</span>
      <% end %>
      <span class="break-all"><%= frame.location %> <span class="text-ink-400/70">in</span> <%= frame.method_name %></span>
    </div>
  <% end %>
<% end %>
