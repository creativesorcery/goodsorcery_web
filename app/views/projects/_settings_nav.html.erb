<%# locals: (project:, current:) -%>
<%# Below lg: a row of links above the page, scrolling sideways if it must. -%>
<nav class="text-[13.5px] max-lg:flex max-lg:gap-1 max-lg:overflow-x-auto max-lg:-mx-1 max-lg:px-1 lg:space-y-0.5 lg:sticky lg:top-24 self-start" aria-label="Project settings">
  <div class="section-label max-lg:hidden">Project</div>
  <%= link_to "Setup & API keys", project_setup_path(project), class: "nav-link shrink-0 whitespace-nowrap", aria: { current: ("page" if current == :setup) } %>
  <%= link_to "General", edit_project_path(project), class: "nav-link shrink-0 whitespace-nowrap", aria: { current: ("page" if current == :general) } %>
  <%= link_to "Alerts", project_alerts_path(project), class: "nav-link shrink-0 whitespace-nowrap", aria: { current: ("page" if current == :alerts) } %>
</nav>
