<%# locals: (project:, progress:) -%>
<% if progress.connected? %>
  <div class="flex flex-wrap items-center gap-4 rounded-xl border border-mint-400/40 bg-mint-400/10 px-4 py-4" role="status">
    <span class="w-3.5 h-3.5 shrink-0 rounded-full bg-mint-500" aria-hidden="true"></span>
    <div class="flex-1 min-w-0">
      <div class="text-[14px] text-ink-50">✦ First event received <%= time_ago_compact(project.first_event_at) %></div>
      <div class="text-[12.5px] text-ink-400">You're connected. New errors appear in Issues as they happen.</div>
    </div>
    <%= link_to "Open issues →", project_issues_path(project), class: "text-[12.5px] text-iris-300 hover:underline" %>
  </div>
<% else %>
  <div class="flex items-center gap-4 rounded-xl border border-dashed border-iris-500/30 bg-iris-500/[.04] px-4 py-4" role="status">
    <%= listening_ping :md %>
    <div class="flex-1 min-w-0">
      <div class="text-[14px] text-ink-50">Listening for your first event…</div>
      <div class="text-[12.5px] text-ink-400">
        Usually arrives within a few seconds. Stuck?
        <%= link_to "Troubleshooting", docs_url, class: "text-iris-300 hover:underline", target: "_blank", rel: "noopener noreferrer" %>
      </div>
    </div>
  </div>
<% end %>
