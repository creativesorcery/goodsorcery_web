<%# locals: (tile:, issues_path: nil) -%>
<%# The range's figure, then "Last hour X"; the p95 subline turns coral with its rise when the total is Slower. -%>
<div class="panel px-4 py-4 min-w-0" data-tile="<%= tile.key %>">
  <div class="text-[12px] text-ink-300"><%= tile.label %></div>
  <div class="font-display text-[30px] leading-none text-ink-50 mt-2.5 whitespace-nowrap"><%= apm_tile_value(tile.format, tile.value) %></div>
  <% if tile.change %>
    <div class="mt-2 flex items-center gap-1.5 text-[12px] text-coral-300">
      <span class="coral-dot" aria-hidden="true"></span>Last hour <%= apm_figure(tile.format, tile.last_hour) %> · ▲ <%= tile.change %>%
    </div>
  <% else %>
    <div class="mt-2 text-[12px] text-ink-300">
      Last hour <%= apm_figure(tile.format, tile.last_hour) %><% if issues_path %> · <%= link_to "see issues", issues_path, class: "text-iris-300 hover:underline" %><% end %>
    </div>
  <% end %>
</div>
