<%# locals: (project:, overview:) -%>
<% counts = overview.tab_counts %>
<div class="mt-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 border-b border-paper-700">
  <nav class="flex items-center gap-6" role="tablist" aria-label="Transactions">
    <% { "web" => "Web requests", "jobs" => "Background jobs" }.each do |tab, label| %>
      <%= link_to project_performance_path(project, overview.link_params(tab:, q: nil)), class: "tab", role: "tab",
            aria: { selected: overview.tab == tab }, data: { turbo_prefetch: false } do %>
        <%= label %> <span class="font-mono text-[11px] text-ink-400 ml-1"><%= delimited(counts[tab]) %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="flex items-center gap-2 pb-2">
    <%= form_with url: project_performance_path(project), method: :get, html: { role: "search" },
          class: "input flex items-center gap-2 rounded-[10px] px-3 py-1.5 w-64" do |form| %>
      <%= icon :search, classes: "w-[15px] h-[15px] text-ink-400" %>
      <% overview.link_params(q: nil).each do |name, value| %>
        <%= hidden_field_tag name, value, id: nil %>
      <% end %>
      <% placeholder = overview.web? ? "Filter endpoints" : "Filter jobs" %>
      <%= form.search_field :q, value: overview.query, placeholder:, "aria-label": placeholder, autocomplete: "off", maxlength: Apm::Selection::QUERY_LIMIT,
            class: "flex-1 min-w-0 bg-transparent outline-none text-[13px] placeholder:text-ink-400/60" %>
    <% end %>

    <div class="relative" data-controller="dropdown">
      <button type="button" class="btn btn-sm py-1.5" data-dropdown-target="button" data-action="dropdown#toggle"
              aria-haspopup="true" aria-expanded="false">Sort: <%= apm_sort_label(overview.sort, web: overview.web?) %> ▾</button>
      <div class="menu right-0" data-dropdown-target="menu" hidden>
        <% PerformanceHelper::SORT_LABELS.each_key do |sort| %>
          <%= link_to apm_sort_label(sort, web: overview.web?), project_performance_path(project, overview.link_params(sort:)),
                class: "menu-item", aria: { current: ("true" if sort == overview.sort) }, data: { turbo_prefetch: false } %>
        <% end %>
      </div>
    </div>
  </div>
</div>
