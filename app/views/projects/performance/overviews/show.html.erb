<% provide :title, "Performance · #{@project.name}" %>
<% provide :nav, "performance" %>
<% breadcrumb Current.account.name, projects_path %>
<% breadcrumb @project.name, project_issues_path(@project) %>
<% breadcrumb "Performance" %>

<div class="page-gutter pt-8 pb-16 max-w-[1400px]">
  <% if @overview.any_data? %>
    <%= render "projects/performance/overviews/header", project: @project, overview: @overview %>
    <%= render "projects/performance/overviews/tiles", project: @project, overview: @overview %>
    <%= render "projects/performance/overviews/layer_chart", overview: @overview %>
    <%= render "projects/performance/overviews/tabs", project: @project, overview: @overview %>
    <%= render "projects/performance/overviews/table", project: @project, overview: @overview %>
  <% else %>
    <div class="rise">
      <div class="eyebrow"><%= @project.name %></div>
      <h1 class="page-title">Performance</h1>
    </div>
    <%= render "projects/performance/overviews/empty", project: @project %>
  <% end %>
</div>
