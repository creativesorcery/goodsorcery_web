<%# locals: (project:, overview:) -%>
<section aria-label="Summary" class="mt-7 grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-3 rise rise-1">
  <% overview.tiles.each do |tile| %>
    <%= render "projects/performance/overviews/tile", tile:,
          issues_path: (project_issues_path(project, env: overview.environment) if tile.key == :failed) %>
  <% end %>
</section>
