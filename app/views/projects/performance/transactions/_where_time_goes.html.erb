<%# locals: (report:) -%>
<% bars = report.bars %>
<section class="panel p-5 rise rise-3" aria-labelledby="apm_where_heading">
  <h2 id="apm_where_heading" class="text-[15px] font-semibold text-ink-50">Where time goes</h2>
  <p class="mt-1 text-[12.5px] text-ink-300"><%= report.transaction.web? ? "Requests" : "Runs" %> around each percentile, split by layer. <%= report.range.label.upcase_first %>.</p>
  <div class="mt-3"><%= render "projects/performance/layer_legend" %></div>
  <% if bars.any? %>
    <div class="mt-4 space-y-3">
      <% bars.each do |bar| %>
        <div class="grid grid-cols-[56px_minmax(0,1fr)_68px] items-center gap-3 text-[12.5px]" data-bar="<%= bar.key %>">
          <span class="text-ink-200"><%= bar.label %></span>
          <%= apm_split_bar_svg(bar.split, scale_ms: bar.value,
                title: PerformanceHelper::LAYER_NAMES.map { |layer, name| "#{name} #{apm_duration(bar.split[layer])}" }.join(" · ")) %>
          <span class="text-right font-mono <%= bar.key == 95 && report.slower_ratio ? "text-coral-300 font-semibold" : "text-ink-50" %>"><%= apm_duration(bar.value) %></span>
        </div>
      <% end %>
    </div>
    <% if (sentence = report.summary_sentence) %>
      <p class="mt-4 rounded-xl bg-paper-850 px-3 py-2.5 text-[12.5px] text-ink-200"><%= sentence %></p>
    <% end %>
  <% else %>
    <p class="mt-4 text-[13.5px] text-ink-400">No <%= report.transaction.web? ? "requests" : "runs" %> in the <%= report.range.label %>.</p>
  <% end %>
</section>
