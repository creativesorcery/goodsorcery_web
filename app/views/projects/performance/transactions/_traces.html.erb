<%# locals: (transaction:, selection:, list:) -%>
<%# Sorting and paging replace only this frame (and advance the URL); trace and issue links leave it. -%>
<% project = transaction.project %>
<% page_path = ->(**overrides) { project_performance_transaction_path(project, transaction, selection.link_params(traces: (list.sort unless list.sort == "slowest"), **overrides)) } %>
<%= turbo_frame_tag dom_id(transaction, :traces), data: { turbo_action: "advance" } do %>
  <section class="panel mt-4 overflow-hidden" aria-labelledby="apm_traces_heading">
    <div class="px-4 sm:px-5 py-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 id="apm_traces_heading" class="text-[15px] font-semibold text-ink-50">Slow traces <span class="font-medium text-ink-300">· <%= selection.range.label %></span></h2>
        <p class="mt-1 text-[12px] text-ink-300">We keep the slowest request each minute this hour, and the 3 slowest of each earlier hour.</p>
      </div>
      <nav class="segmented" aria-label="Sort traces">
        <% { "slowest" => "Slowest", "newest" => "Newest" }.each do |sort, label| %>
          <%= link_to label, project_performance_transaction_path(project, transaction, selection.link_params(traces: (sort unless sort == "slowest"))),
                aria: { current: ("true" if list.sort == sort) }, data: { turbo_prefetch: false } %>
        <% end %>
      </nav>
    </div>
    <% if list.traces.any? %>
      <% cell = PerformanceHelper::DESKTOP_CELL %>
      <div class="scroll-x">
        <div class="md:min-w-[760px]">
          <div class="<%= PerformanceHelper::TRACE_GRID %> px-4 sm:px-5 py-2 text-[11px] uppercase tracking-[.16em] text-ink-400/80 border-y border-paper-700 bg-paper-850/60">
            <span>Time</span><span class="text-right">Duration</span><span class="<%= cell %> text-right">Database</span><span class="<%= cell %> text-right">Queries</span>
            <span class="<%= cell %> text-right whitespace-nowrap">External HTTP</span><span class="<%= cell %>">Status</span><span></span>
          </div>
          <% list.traces.each do |trace| %>
            <% issue = list.issue_for(trace) %>
            <div class="<%= PerformanceHelper::TRACE_GRID %> relative px-4 sm:px-5 py-3 border-b border-paper-700/70 last:border-b-0 hover:bg-iris-500/[.04] transition text-[13px]">
              <span class="<%= PerformanceHelper::TRACE_TIME %> min-w-0">
                <span class="block font-mono text-ink-100"><%= apm_clock(trace.started_at) %></span>
                <span class="<%= PerformanceHelper::MOBILE_ONLY %> block text-[12px] text-ink-300">db <%= apm_duration(trace.db_ms) %> · <%= pluralize(delimited(trace.sql_count), "query") %><%= " · http #{apm_duration(trace.http_ms)}" if trace.http_count.positive? %></span>
              </span>
              <span class="text-right font-mono font-semibold text-ink-50"><%= apm_duration(trace.duration_ms) %></span>
              <span class="<%= cell %> text-right font-mono text-ink-100"><%= apm_duration(trace.db_ms) %></span>
              <span class="<%= cell %> text-right font-mono text-ink-100"><%= delimited(trace.sql_count) %></span>
              <span class="<%= cell %> text-right font-mono text-ink-100"><%= trace.http_count.positive? ? "#{apm_duration(trace.http_ms)} · #{trace.http_count}" : "—" %></span>
              <span class="<%= PerformanceHelper::TRACE_STATUS %> flex flex-wrap items-center gap-1.5">
                <span class="chip chip-sm <%= apm_failed_status?(trace) ? "chip-coral" : "chip-mint" %>"><%= apm_status_code(trace) %></span>
                <% if issue %>
                  <%= link_to issue.short_id, project_issue_path(project, issue), class: "relative z-10 chip chip-sm chip-coral font-mono hover:underline",
                        data: { turbo_frame: "_top" } %>
                <% end %>
              </span>
              <%= link_to "Trace →", project_performance_trace_path(project, trace, selection.link_params),
                    class: "#{PerformanceHelper::TRACE_LINK} text-right text-[12.5px] font-semibold text-iris-300 after:absolute after:inset-0 focus:outline-none",
                    data: { turbo_frame: "_top" }, "aria-label": "Trace of #{apm_clock(trace.started_at)}, #{apm_duration(trace.duration_ms)}" %>
            </div>
          <% end %>
        </div>
      </div>
      <div class="px-4 sm:px-5 py-3 flex flex-wrap items-center justify-between gap-3 border-t border-paper-700 text-[12.5px] text-ink-300">
        <span>
          <%= list.first_number == 1 ? delimited(list.last_number) : "#{delimited(list.first_number)}–#{delimited(list.last_number)}" %>
          of <%= pluralize(delimited(list.total), "trace") %> in the <%= selection.range.label %>
        </span>
        <span class="flex items-center gap-4">
          <% if list.previous_page? %>
            <%= link_to "← Previous #{Apm::TraceList::PER_PAGE}", page_path.call(page: (list.page - 1 if list.page > 2)), class: "tap-link font-semibold text-iris-300 hover:underline" %>
          <% end %>
          <% if list.next_page? %>
            <%= link_to "Next #{Apm::TraceList::PER_PAGE} →", page_path.call(page: list.page + 1), class: "tap-link font-semibold text-iris-300 hover:underline" %>
          <% end %>
        </span>
      </div>
    <% elsif list.page > 1 && !list.empty? %>
      <p class="px-5 pb-5 text-[13.5px] text-ink-400">No traces on this page. <%= link_to "Back to the first page", page_path.call, class: "tap-link text-iris-300 hover:underline" %></p>
    <% else %>
      <p class="px-5 pb-5 text-[13.5px] text-ink-400">No traces in the <%= selection.range.label %>.</p>
    <% end %>
  </section>
<% end %>
