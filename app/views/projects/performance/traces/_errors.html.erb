<%# locals: (project:, page:) -%>
<section class="panel p-5 rise rise-4" aria-labelledby="apm_request_errors_heading">
  <h2 id="apm_request_errors_heading" class="text-[14px] font-semibold text-ink-50 mb-2">Errors in this <%= page.web? ? "request" : "run" %></h2>
  <% if (issue = page.error_issue) %>
    <%= link_to project_issue_path(project, issue), class: "block rounded-xl px-3 py-2.5 -mx-1 hover:bg-paper-850 transition" do %>
      <span class="flex flex-wrap items-center gap-2 min-w-0"><%= issue_class_name(issue) %><%= issue_badge(issue) %></span>
      <span class="block mt-0.5 text-[13px] text-ink-100 truncate"><%= issue_title(issue) %></span>
      <span class="block mt-1 font-mono text-[11.5px] text-ink-400"><%= issue.short_id %></span>
    <% end %>
  <% elsif page.error_reported? %>
    <p class="text-[13px] text-ink-300">Error reported, but its event is no longer stored.</p>
  <% else %>
    <p class="text-[13px] text-mint-300">None. <%= page.web? ? "Requests" : "Runs" %> that raise link straight to their issue.</p>
  <% end %>
</section>
