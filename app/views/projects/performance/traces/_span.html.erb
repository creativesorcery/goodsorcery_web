<%# locals: (span:, total:, ticks:, detailed:) -%>
<%# One timeline row; the N+1 group shown in detail below links to it. -%>
<% row_classes = "#{PerformanceHelper::TIMELINE_GRID} px-4 sm:px-5 py-2 border-b border-paper-700/70 last:border-b-0" %>
<% content = capture do %>
  <span class="<%= PerformanceHelper::TIMELINE_LABEL %> flex items-center gap-2 min-w-0">
    <span class="w-14 shrink-0 text-[10.5px] font-semibold uppercase tracking-wide text-ink-400"><%= apm_span_type(span) %></span>
    <span class="font-mono text-[12.5px] truncate <%= span.n_plus_one? ? "text-ink-50 font-semibold" : "text-ink-100" %>" title="<%= apm_span_label(span) %>"><%= apm_span_label(span) %></span>
    <% if span.n_plus_one? %>
      <%= apm_n_plus_one_chip(span.calls) %>
    <% elsif span.grouped? %>
      <%= chip "×#{span.calls}", small: true, mono: true %>
    <% end %>
  </span>
  <%= apm_timeline_bar_svg(span.offset_ms, span.extent_ms, total, color: PerformanceChartHelper::LAYER_COLORS.fetch(span.layer), ticks:, tall: span.n_plus_one?) %>
  <span class="text-right font-mono text-[12px] <%= span.n_plus_one? ? "text-coral-300 font-semibold" : "text-ink-100" %>"><%= apm_duration(span.duration_ms) %></span>
<% end %>
<% if detailed %>
  <a href="#span-detail" class="<%= row_classes %> bg-lilac-400/[.07] hover:bg-lilac-400/[.12] transition" aria-current="true"><%= content %></a>
<% else %>
  <div class="<%= row_classes %>"><%= content %></div>
<% end %>
