<%# locals: (page:) -%>
<section class="panel p-5 rise rise-3" aria-labelledby="apm_request_heading">
  <h2 id="apm_request_heading" class="text-[14px] font-semibold text-ink-50 mb-3"><%= page.web? ? "Request" : "Job" %></h2>
  <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-5 gap-y-2 text-[13px]">
    <% apm_trace_facts(page).each do |label, value| %>
      <dt class="text-ink-300"><%= label %></dt><dd class="font-mono text-[12.5px] text-ink-50 break-words"><%= value %></dd>
    <% end %>
  </dl>
  <p class="mt-3.5 text-[12px] text-ink-300">Traces carry no params, headers, cookies or bodies.</p>
</section>
