<%# locals: (project:, progress:) -%>
<section class="panel p-5 rise rise-2">
  <h2 class="font-display text-[20px] text-ink-50"><span class="text-iris-400 font-mono text-[14px] mr-2">ii.</span>Cast a test error</h2>
  <div class="mt-4">
<%= render layout: "projects/setups/snippet", locals: { label: "terminal" } do %><span class="text-iris-400 select-none" data-clipboard-skip>$ </span>bin/rails goodsorcery:test<% end %>
  </div>
  <%# Live frame: slice G sends reload_frame here on [project, :setup]. -%>
  <%= turbo_frame_tag dom_id(project, :listening), target: "_top", class: "mt-5" do %>
    <%= render "projects/listenings/listening", project:, progress: %>
  <% end %>
</section>
