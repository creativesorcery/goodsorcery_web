<aside class="space-y-6">
  <div class="panel p-5 rise rise-2">
    <div class="text-[11px] uppercase tracking-[.18em] text-ink-400">What gets captured</div>
    <ul class="mt-3 space-y-2.5 text-[13px] text-ink-200">
      <li class="flex gap-2"><span class="text-iris-400">✦</span>Unhandled exceptions in controllers, jobs (ActiveJob, Sidekiq) and rake tasks</li>
      <li class="flex gap-2"><span class="text-iris-400">✦</span>Breadcrumbs from ActiveSupport notifications: SQL, HTTP, cache, logs</li>
      <li class="flex gap-2"><span class="text-iris-400">✦</span><span><span class="font-mono text-[12px]">current_user</span> via a one-line hook</span></li>
    </ul>
  </div>

  <div class="panel p-5 rise rise-3">
    <div class="text-[11px] uppercase tracking-[.18em] text-ink-400">Scrubbed by default</div>
    <p class="text-[13px] text-ink-300 mt-3">
      Everything in <span class="font-mono text-[12px] text-ink-100 break-all">Rails.application.config.filter_parameters</span>,
      plus passwords, tokens, cookies and Authorization headers. Filtering runs <em class="font-display">inside your app</em>,
      so secrets never leave the process; the server scrubs again, card-shaped numbers included.
    </p>
  </div>

  <%= render "projects/setups/self_hosting", setting: "config.endpoint", line: %(config.endpoint = "#{instance_endpoint}"), package: "gem" %>
</aside>
