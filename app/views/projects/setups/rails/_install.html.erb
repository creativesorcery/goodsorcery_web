<%# locals: (api_key:) -%>
<%# Snippets carry the default key in full, ready to paste. -%>
<section class="panel overflow-hidden rise rise-1" data-controller="tabs">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-4">
    <%= setup_step_heading "i.", "Add the gem" %>
    <div class="flex items-center gap-5" role="tablist" aria-label="Install method">
      <%= setup_tab "Generator", "install_generator", selected: true %>
      <%= setup_tab "Manual", "install_manual" %>
      <%= setup_tab "ENV only", "install_env" %>
    </div>
  </div>

  <div id="install_generator" role="tabpanel" data-tabs-target="panel" class="p-5 pt-4 space-y-3">
<%= render layout: "projects/setups/snippet", locals: { label: "terminal" } do %><span class="text-iris-400 select-none" data-clipboard-skip>$ </span>bundle add goodsorcery
<span class="text-iris-400 select-none" data-clipboard-skip>$ </span>bin/rails generate goodsorcery:install --api-key=<span class="tok-s"><%= install_key_hint(api_key) %></span><% end %>
    <p class="text-[13px] text-ink-400">
      The generator writes <span class="font-mono text-ink-200">config/initializers/goodsorcery.rb</span> and stores the key in Rails credentials.
      <span class="font-mono text-ink-200">bin/rails goodsorcery:verify</span> then checks the key and endpoint without sending anything.
    </p>
    <p class="text-[13px] text-ink-400">
      For response times and slow-request traces under <span class="text-ink-200">Performance</span>, uncomment
      <span class="font-mono text-ink-200">config.performance_monitoring = true</span> in that initializer (it's off by default).
    </p>
  </div>

  <div id="install_manual" role="tabpanel" data-tabs-target="panel" class="p-5 pt-4 space-y-3" hidden>
<%= render layout: "projects/setups/snippet", locals: { label: "Gemfile" } do %>gem <span class="tok-s">"goodsorcery"</span>, <span class="tok-s">"~&gt; 0.1"</span><% end %>
<%= render layout: "projects/setups/snippet", locals: { label: "config/initializers/goodsorcery.rb" } do %><span class="tok-sym">GoodSorcery</span>.configure <span class="tok-k">do</span> |config|
  config.api_key      = Rails.application.credentials.dig(<span class="tok-sym">:goodsorcery</span>, <span class="tok-sym">:api_key</span>)
  config.environment  = Rails.env
  config.filter_params += <span class="tok-n">%i[card_token ssn]</span>  <span class="tok-c"># on top of the defaults and Rails' filter_parameters</span>
  <%= endpoint_config_line %>

  <%= performance_config_lines %>
<span class="tok-k">end</span><% end %>
  </div>

  <%= render "projects/setups/install_env", api_key: %>
</section>
