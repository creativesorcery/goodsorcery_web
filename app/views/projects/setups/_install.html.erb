<%# locals: (api_key:) -%>
<%# Snippets show the masked default key only; the full key sits behind Reveal below. -%>
<section class="panel overflow-hidden rise rise-1" data-controller="tabs">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-4">
    <h2 class="font-display text-[20px] text-ink-50"><span class="text-iris-400 font-mono text-[14px] mr-2">i.</span>Add the gem</h2>
    <div class="flex items-center gap-5" role="tablist" aria-label="Install method">
      <button type="button" class="tab" role="tab" aria-selected="true" aria-controls="install_generator" data-tabs-target="tab" data-action="tabs#select">Generator</button>
      <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="install_manual" data-tabs-target="tab" data-action="tabs#select">Manual</button>
      <button type="button" class="tab" role="tab" aria-selected="false" aria-controls="install_env" data-tabs-target="tab" data-action="tabs#select">ENV only</button>
    </div>
  </div>

  <div id="install_generator" role="tabpanel" data-tabs-target="panel" class="p-5 pt-4 space-y-3">
<%= render layout: "projects/setups/snippet", locals: { label: "terminal" } do %><span class="text-iris-400 select-none" data-clipboard-skip>$ </span>bundle add goodsorcery
<span class="text-iris-400 select-none" data-clipboard-skip>$ </span>bin/rails generate goodsorcery:install --api-key=<span class="tok-s"><%= install_key_hint(api_key) %></span><% end %>
    <p class="text-[13px] text-ink-400">
      The generator writes <span class="font-mono text-ink-200">config/initializers/goodsorcery.rb</span>, stores the key in Rails credentials
      and adds <span class="font-mono text-ink-200">plugin "goodsorcery"</span> to your Gemfile, so every <span class="font-mono text-ink-200">bundle install</span>
      in development checks the key and endpoint. <span class="font-mono text-ink-200">bin/rails goodsorcery:test</span> sends a test error.
    </p>
  </div>

  <div id="install_manual" role="tabpanel" data-tabs-target="panel" class="p-5 pt-4 space-y-3" hidden>
<%= render layout: "projects/setups/snippet", locals: { label: "Gemfile" } do %>gem <span class="tok-s">"goodsorcery"</span>, <span class="tok-s">"~&gt; 0.1"</span>
plugin <span class="tok-s">"goodsorcery"</span>  <span class="tok-c"># optional: checks your key after bundle install (development)</span><% end %>
<%= render layout: "projects/setups/snippet", locals: { label: "config/initializers/goodsorcery.rb" } do %><span class="tok-sym">GoodSorcery</span>.configure <span class="tok-k">do</span> |config|
  config.api_key      = Rails.application.credentials.dig(<span class="tok-sym">:goodsorcery</span>, <span class="tok-sym">:api_key</span>)
  config.environment  = Rails.env
  config.filter_params += <span class="tok-n">%i[card_token ssn]</span>  <span class="tok-c"># on top of the defaults and Rails' filter_parameters</span>
  <%= endpoint_config_line %>
<span class="tok-k">end</span><% end %>
  </div>

  <div id="install_env" role="tabpanel" data-tabs-target="panel" class="p-5 pt-4" hidden>
<%= render layout: "projects/setups/snippet", locals: { label: ".env / platform config" } do %>GOODSORCERY_API_KEY=<span class="tok-s"><%= install_key_hint(api_key) %></span>
GOODSORCERY_ENV=<span class="tok-s"><%= api_key&.environment || "production" %></span><%= endpoint_env_line %><% end %>
  </div>

  <p class="px-5 pb-4 text-[12.5px] text-ink-400">Reveal your key under <a href="#api_keys" class="text-iris-300 hover:underline">API keys</a> below.</p>
</section>
