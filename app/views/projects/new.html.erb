<% provide :title, "Add a new app" %>
<% provide :nav, "projects" %>
<% breadcrumb Current.account.name, projects_path %>
<% breadcrumb "Add a new app" %>

<div class="page-gutter py-8 max-w-[720px]">
  <div class="rise">
    <div class="eyebrow">Step 1 of 3</div>
    <h1 class="page-title">Add a new app</h1>
    <p class="text-[15px] text-ink-300 mt-3">One library, one key, two minutes. Next you'll get an install snippet and a key for each environment.</p>
  </div>

  <section class="panel p-6 mt-6 rise rise-1">
    <% if project_limit_reached? %>
      <div id="project_limit" class="text-center py-4">
        <h2 class="font-display text-[20px] text-ink-50"><%= Project.limit_message(entitlements.max_projects) %></h2>
        <div class="mt-4 flex items-center justify-center gap-3 text-[13.5px]">
          <%= upgrade_to_unlock %>
          <%= link_to "Back to Projects", projects_path, class: "btn btn-ghost" %>
        </div>
      </div>
    <% else %>
      <%= render "projects/form", project: @project %>
    <% end %>
  </section>
</div>
