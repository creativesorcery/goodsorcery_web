<% provide :title, "Add a new app" %>
<% provide :nav, "projects" %>
<% breadcrumb Current.account.name, projects_path %>
<% breadcrumb "Add a new app" %>

<div class="px-8 py-8 max-w-[720px]">
  <div class="rise">
    <div class="eyebrow">Step 1 of 3</div>
    <h1 class="page-title">Add a new app</h1>
    <p class="text-[15px] text-ink-300 mt-3">One gem, one key, two minutes. Next you'll get an install snippet and a key for each environment.</p>
  </div>

  <section class="panel p-6 mt-6 rise rise-1">
    <%= render "projects/form", project: @project %>
  </section>
</div>
