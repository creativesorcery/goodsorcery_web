<%# locals: (project:, limit_reached:, count: nil) -%>
<% if limit_reached %>
  <div class="flex flex-wrap items-center justify-center gap-3 text-[13px]">
    <% if entitlements.max_monitors.positive? %>
      <%= chip "#{count} of #{entitlements.max_monitors} #{'monitor'.pluralize(entitlements.max_monitors)} used", tone: :muted %>
    <% end %>
    <%= upgrade_to_unlock %>
  </div>
<% else %>
  <%= link_to new_project_uptime_monitor_path(project), class: "btn btn-primary" do %>
    <%= icon :plus, classes: "w-4 h-4" %> Add a monitor
  <% end %>
<% end %>
