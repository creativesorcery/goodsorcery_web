<%# locals: (project:, api_key:, default: api_key.default?, revealed: false) -%>
<%# Never fragment-cached: a revealed row holds the full token. -%>
<%= turbo_frame_tag dom_id(api_key) do %>
  <%# Phones put Rotate under the key, so the key keeps the row's width. -%>
  <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center gap-3 sm:gap-4 px-4 sm:px-5 py-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2 text-[14px] text-ink-50">
        <%= environment_dot(api_key.environment) %>
        <%= api_key_label(api_key) %>
        <%# The first key is the one the setup page's install steps use; not the app's default environment (Settings › General). -%>
        <% if default %><span title="The install steps on this page use this key"><%= chip "used in setup", small: true %></span><% end %>
      </div>
      <%= turbo_frame_tag dom_id(api_key, :token), class: "mt-2" do %>
        <%= render "projects/api_keys/token", project:, api_key:, revealed: %>
      <% end %>
      <div class="text-[12px] text-ink-400 mt-2"><%= api_key_history(api_key) %></div>
    </div>
    <%= button_to "Rotate…", project_api_key_rotation_path(project, api_key), class: "btn text-[12.5px]", form_class: "justify-self-start",
          form: { data: { turbo_confirm: "The old key stops working immediately." } } %>
  </div>
<% end %>
