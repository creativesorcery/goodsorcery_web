<%# locals: (project:, api_key:, open: false) -%>
<%= tag.details id: dom_id(project, :new_api_key), class: "relative", open: do %>
  <summary class="btn"><%= icon :plus, classes: "w-4 h-4" %>New key</summary>
  <div class="menu right-0 w-80 p-4">
    <%= form_with model: api_key, url: project_api_keys_path(project), class: "space-y-3" do |form| %>
      <div>
        <%= form.label :environment, "Environment", class: "label" %>
        <%= form.text_field :environment, class: "field font-mono", required: true, maxlength: 32, autocomplete: "off",
              placeholder: "review", pattern: "[a-z0-9][a-z0-9_\\-]{0,31}", "aria-describedby": dom_id(project, :new_api_key_hint) %>
        <p id="<%= dom_id(project, :new_api_key_hint) %>" class="hint">Lowercase letters, numbers, - and _. One key per environment.</p>
        <% api_key.errors.full_messages.each do |message| %>
          <p class="mt-1.5 text-[12.5px] text-coral-300" role="alert"><%= message %></p>
        <% end %>
      </div>
      <%= form.submit "Create key", class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
<% end %>
