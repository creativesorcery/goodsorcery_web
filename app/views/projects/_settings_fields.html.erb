<%# locals: (form:, project:) -%>
<div>
  <%= form.label :issue_prefix, "Issue prefix", class: "label" %>
  <%= form.text_field :issue_prefix, class: "field font-mono uppercase max-w-[10rem]", required: true, maxlength: 6,
        pattern: "[A-Za-z]{1,6}", autocomplete: "off" %>
  <p class="hint">Short IDs look like <span class="font-mono text-ink-200"><%= project.issue_prefix_in_database %>-1042</span>. Changing the prefix changes every issue's short ID.</p>
</div>

<div>
  <%= form.label :default_environment, "Default environment", class: "label" %>
  <%= form.select :default_environment, project.environments, { include_blank: "All environments" }, class: "field max-w-[16rem]" %>
  <p class="hint">The issue list opens on this environment. Each person's last pick in the list's environment switch wins over it.</p>
</div>

<div>
  <%= form.label :scrub_fields, "Extra scrubbed fields", class: "label" %>
  <%= form.text_field :scrub_fields, value: project.scrub_fields.join(", "), class: "field font-mono",
        placeholder: "loyalty_number, passport", autocomplete: "off" %>
  <p class="hint">Comma separated. Matching keys are replaced with [FILTERED] on arrival, on top of the built-in rules.</p>
</div>

<div>
  <% retention_locked = entitlements.locked_retention_days.any? %>
  <%= form.label :retention_days, "Retention", class: "label" %>
  <%= form.select :retention_days, project_retention_options, { disabled: entitlements.locked_retention_days },
        class: "field max-w-[22rem]",
        aria: { invalid: (project.errors[:retention_days].any? ? "true" : nil),
                describedby: [ ("project_retention_days_locked_hint" if retention_locked), "project_retention_days_hint" ].compact.join(" ") } %>
  <% if retention_locked %>
    <%= project_locked_retention_hint_tag %>
  <% end %>
  <p id="project_retention_days_hint" class="hint">Occurrences older than this are deleted. Each app also keeps at most <%= number_with_delimiter(Occurrence::RETAINED_PER_PROJECT) %> occurrences, dropping the oldest copies of its most repeated issues first. Events are still counted.</p>
</div>
