<%# Below lg this is the drawer (drawer_controller), like the app's sidebar. -%>
<aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-50 flex w-[min(85vw,288px)] shrink-0 flex-col border-r border-iris-500/10 bg-paper-900 lg:sticky lg:top-0 lg:z-auto lg:h-screen lg:w-[248px] lg:bg-paper-900/60 lg:backdrop-blur"
       aria-label="Navigation" data-drawer-target="panel" data-action="click->drawer#closeOnLink">
  <div class="flex items-center">
    <%= link_to staff_root_path, class: "flex flex-1 min-w-0 items-center gap-3 px-5 pt-5 pb-4" do %>
      <span class="w-8 h-8"><%= render "shared/sigil" %></span>
      <span class="leading-none">
        <span class="block font-display text-[18px] text-ink-50 tracking-tight">Good Sorcery</span>
        <span class="block text-[10.5px] uppercase tracking-[.18em] text-iris-300 font-semibold mt-1">Staff</span>
      </span>
    <% end %>
    <button type="button" class="icon-btn mr-3 lg:hidden" data-action="drawer#close" aria-label="Close menu">
      <%= icon :close, classes: "w-5 h-5" %>
    </button>
  </div>

  <nav class="flex-1 lg:overflow-y-auto px-3 mt-5 space-y-0.5" aria-label="Staff">
    <div class="section-label">Staff</div>
    <%= nav_link_to "Accounts", staff_accounts_path, key: "staff_accounts", icon: :accounts %>
    <%= nav_link_to "Users", staff_users_path, key: "staff_users", icon: :users %>

    <div class="section-label pt-5">Good Sorcery</div>
    <%= link_to root_path, class: "nav-link" do %>
      <%= icon :arrow_left %><span class="flex-1">Back to the app</span>
    <% end %>
  </nav>

  <div class="flex items-center gap-3 border-t border-iris-500/10 px-5 py-4">
    <%= initials_avatar Current.user.name, size: :lg %>
    <span class="flex-1 min-w-0 leading-tight">
      <span class="block text-[13px] text-ink-100 truncate"><%= Current.user.name %></span>
      <span class="block text-[11px] text-ink-400 truncate"><%= Current.user.email_address %></span>
    </span>
  </div>
</aside>
