<% provide :title, "#{@account.name} · Staff" %>
<% provide :nav, "staff_accounts" %>
<% breadcrumb "Staff", staff_root_path %>
<% breadcrumb "Accounts", staff_accounts_path %>
<% breadcrumb @account.name %>

<div class="page-gutter pt-8 pb-16 max-w-[1100px]">
  <div class="page-header rise">
    <div class="min-w-0">
      <div class="eyebrow">Account <span class="font-mono">#<%= @account.id %></span></div>
      <h1 class="page-title break-words"><%= @account.name %></h1>
      <p class="mt-2 text-[13.5px] text-ink-300">Created <%= staff_date(@account.created_at) %></p>
    </div>
    <%= link_to "Edit entitlements", edit_staff_account_path(@account), class: "btn btn-primary" %>
  </div>

  <%= render "staff/shared/self_hosted_notice" %>

  <section id="account_entitlements" class="panel mt-6 overflow-hidden rise rise-1" aria-labelledby="entitlements_heading">
    <div class="px-5 py-3 border-b border-paper-700">
      <h2 id="entitlements_heading" class="font-semibold text-ink-50">Entitlements</h2>
      <p class="text-[12.5px] text-ink-400">What applies in hosted mode. A default comes from <span class="font-mono">config/entitlements.yml</span>.</p>
    </div>
    <dl class="divide-y divide-paper-700/70">
      <% staff_entitlement_rows(@form).each do |row| %>
        <div id="entitlement_<%= row.key %>" class="flex flex-wrap items-center gap-x-4 gap-y-1 px-5 py-3">
          <dt class="flex-1 min-w-[12rem]">
            <span class="block text-[13.5px] text-ink-100"><%= row.label %></span>
            <span class="block font-mono text-[11.5px] text-ink-400"><%= row.key %></span>
          </dt>
          <dd class="font-mono text-[13px] text-ink-50"><%= row.value %></dd>
          <dd><%= chip row.source, tone: row.source == "Stored" ? :iris : :muted, small: true %></dd>
        </div>
      <% end %>
    </dl>
  </section>

  <section class="panel mt-6 overflow-hidden rise rise-2" aria-labelledby="account_users_heading">
    <h2 id="account_users_heading" class="px-5 py-3 border-b border-paper-700 font-semibold text-ink-50">
      Users <span class="text-ink-400 font-normal">— <%= @memberships.size %></span>
    </h2>
    <% if @memberships.empty? %>
      <p class="px-5 py-6 text-[13.5px] text-ink-400">No users.</p>
    <% else %>
      <div class="scroll-x">
        <table id="account_users" class="w-full min-w-[36rem] text-[13.5px]">
          <thead class="<%= StaffHelper::TABLE_HEAD_CLASSES %>">
            <tr>
              <th scope="col" class="px-5 py-2.5 font-normal">ID</th>
              <th scope="col" class="px-5 py-2.5 font-normal">Name</th>
              <th scope="col" class="px-5 py-2.5 font-normal">Email</th>
              <th scope="col" class="px-5 py-2.5 font-normal">Role</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-paper-700/70">
            <% @memberships.each do |membership| %>
              <% user = membership.user %>
              <tr id="<%= dom_id(user, :staff) %>">
                <td class="px-5 py-3 font-mono text-[12.5px] text-ink-400"><%= user.id %></td>
                <td class="px-5 py-3"><%= link_to user.name, staff_user_path(user), class: "text-ink-50 hover:underline" %></td>
                <td class="px-5 py-3 text-ink-300 break-all"><%= user.email_address %></td>
                <td class="px-5 py-3"><%= staff_role_chip(membership) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
