<%# locals: (wrapper_class: "") -%>
<div id="flash" class="<%= wrapper_class %>" aria-live="polite">
  <% if flash[:notice].present? %>
    <div class="panel mt-4 flex items-center gap-3 px-4 py-2.5 rise" role="status" data-controller="flash">
      <%= chip "Done", tone: :mint %>
      <span class="flex-1 text-[13.5px] text-ink-100"><%= flash[:notice] %></span>
      <button type="button" class="text-ink-400 hover:text-ink-50" data-action="flash#dismiss" aria-label="Dismiss">×</button>
    </div>
  <% end %>
  <% if flash[:alert].present? %>
    <div class="panel mt-4 flex items-center gap-3 px-4 py-2.5 rise" role="alert" data-controller="flash" data-flash-delay-value="0">
      <%= chip "Heads up", tone: :coral %>
      <span class="flex-1 text-[13.5px] text-ink-100"><%= flash[:alert] %></span>
      <button type="button" class="text-ink-400 hover:text-ink-50" data-action="flash#dismiss" aria-label="Dismiss">×</button>
    </div>
  <% end %>
</div>
