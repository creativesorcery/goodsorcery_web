<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= document_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="application-name" content="Good Sorcery">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= google_font_tags %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# The staff area (Staff::BaseController): the app's shell without anything account-scoped. -%>
  <body class="min-h-screen" data-controller="drawer" data-action="keydown->drawer#keydown">
    <div class="flex">
      <div class="drawer-backdrop lg:hidden" data-drawer-target="backdrop" data-action="click->drawer#close" hidden></div>
      <%= render "staff/shared/sidebar" %>

      <main class="flex-1 min-w-0">
        <%= render "staff/shared/topbar" %>
        <%= render "layouts/flash", wrapper_class: "page-gutter" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
