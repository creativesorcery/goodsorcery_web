<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      /* Email clients ignore external CSS; keep styles small and inline-safe. */
      body { margin: 0; padding: 32px 16px; background: #f7f6f3; color: #34374d; font-family: Figtree, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.55; }
      .card { max-width: 480px; margin: 0 auto; background: #ffffff; border: 1px solid #e7e5df; border-radius: 16px; padding: 32px; }
      .brand { font-weight: 700; color: #23253a; font-size: 17px; letter-spacing: -0.01em; }
      .muted { color: #80849a; font-size: 13px; }
      .button { display: inline-block; background: #5a5fd6; color: #ffffff !important; text-decoration: none; font-weight: 600; padding: 10px 18px; border-radius: 10px; }
      a { color: #5a5fd6; }
    </style>
  </head>

  <body>
    <div class="card">
      <p class="brand">✦ Good Sorcery</p>
      <%= yield %>
    </div>
  </body>
</html>
