<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= document_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Good Sorcery">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= google_font_tags %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <main class="min-h-screen grid place-items-center px-6 py-12">
      <div class="w-full max-w-[420px]">
        <div class="flex flex-col items-center text-center rise">
          <span class="w-11 h-11"><%= render "shared/sigil" %></span>
          <span class="mt-3 font-display text-[22px] text-ink-50 tracking-tight">Good Sorcery</span>
          <span class="text-[10.5px] uppercase tracking-[.18em] text-ink-400 font-semibold mt-1">Error Tracker</span>
        </div>

        <%= render "layouts/flash", wrapper_class: "mt-6" %>

        <div class="panel p-8 mt-6 rise rise-1">
          <%= yield %>
        </div>

        <%= yield :auth_footer %>
      </div>
    </main>
  </body>
</html>
