<% project = sidebar_project %>
<%# Below lg this is the drawer (drawer_controller): fixed, off-screen and hidden until the top bar menu button opens it. -%>
<aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-50 flex w-[min(85vw,288px)] shrink-0 flex-col border-r border-iris-500/10 bg-paper-900 lg:sticky lg:top-0 lg:z-auto lg:h-screen lg:w-[248px] lg:bg-paper-900/60 lg:backdrop-blur"
       aria-label="Navigation" data-drawer-target="panel" data-action="click->drawer#closeOnLink">
  <div class="flex items-center">
    <%= link_to root_path, class: "flex flex-1 min-w-0 items-center gap-3 px-5 pt-5 pb-4" do %>
      <span class="w-8 h-8"><%= render "shared/sigil" %></span>
      <span class="leading-none">
        <span class="block font-display text-[18px] text-ink-50 tracking-tight">Good Sorcery</span>
        <span class="block text-[10.5px] uppercase tracking-[.18em] text-ink-400 font-semibold mt-1">Error Tracker</span>
      </span>
    <% end %>
    <button type="button" class="icon-btn mr-3 lg:hidden" data-action="drawer#close" aria-label="Close menu">
      <%= icon :close, classes: "w-5 h-5" %>
    </button>
  </div>

  <%= render "layouts/project_switcher", project: project %>

  <nav class="flex-1 overflow-y-auto px-3 mt-5 space-y-0.5" aria-label="Main">
    <div class="section-label">Grimoire</div>
    <%= nav_link_to "Projects", projects_path, key: "projects", icon: :projects %>
    <% if project %>
      <%= nav_link_to "Issues", project_issues_path(project), key: "issues", icon: :issues, badge: sidebar_issues_badge %>
      <%= nav_link_to "Performance", project_performance_path(project), key: "performance", icon: :performance %>
      <%= nav_link_to "Uptime", project_uptime_monitors_path(project), key: "uptime", icon: :uptime, badge: sidebar_uptime_badge %>
      <%= nav_link_to "Alerts", project_alerts_path(project), key: "alerts", icon: :alerts %>
    <% else %>
      <%= nav_placeholder "Issues", icon: :issues %>
      <%= nav_placeholder "Performance", icon: :performance %>
      <%= nav_placeholder "Uptime", icon: :uptime %>
      <%= nav_placeholder "Alerts", icon: :alerts %>
    <% end %>

    <div class="section-label pt-5">Project</div>
    <% if project %>
      <%= nav_link_to "Settings & setup", project_setup_path(project), key: "settings", icon: :settings %>
    <% end %>
    <%= link_to docs_url, class: "nav-link", target: "_blank", rel: "noopener noreferrer" do %>
      <%= icon :book %><span class="flex-1">Docs</span><%= icon :external, classes: "w-3.5 h-3.5 text-ink-400" %>
    <% end %>
  </nav>

  <%= render "layouts/usage_meter" %>
  <%= render "layouts/user_menu" %>
</aside>
