<%# A 40px icon button below lg; from lg the original small ×. -%>
<button type="button" class="ml-auto text-ink-400 hover:text-ink-50 max-lg:inline-flex max-lg:h-10 max-lg:w-10 max-lg:shrink-0 max-lg:items-center max-lg:justify-center max-lg:rounded-lg max-lg:transition max-lg:hover:bg-paper-800"
        data-action="flash#dismiss" aria-label="Dismiss"><span class="lg:hidden"><%= icon :close, classes: "block w-4 h-4" %></span><span class="max-lg:hidden">×</span></button>
