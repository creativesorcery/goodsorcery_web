<%# Shown on every dashboard page until the user confirms their email address. -%>
<div class="page-gutter">
  <div class="panel mt-4 flex flex-wrap items-center gap-3 px-4 py-2.5" role="status">
    <%= chip "Confirm your email", tone: :iris %>
    <span class="flex-1 min-w-[min(16rem,100%)] break-words text-[13.5px] text-ink-100">
      We sent a link to <span class="font-semibold"><%= Current.user.email_address %></span>.
      Click it to start adding apps and API keys.
    </span>
    <%= button_to "Resend email", email_verification_path, class: "btn btn-sm", form_class: "contents" %>
  </div>
</div>
