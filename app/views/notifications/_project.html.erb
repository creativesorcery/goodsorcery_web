<%# locals: (project:, preference:) -%>
<% receives_alerts = preference.receives?("alerts") %>
<% receives_digest = preference.receives?("digest") %>
<li id="<%= dom_id(project, :notifications) %>" class="<%= AlertsHelper::NOTIFICATION_ROW_GRID %> items-center px-5 py-3.5">
  <div class="flex items-center gap-3 min-w-0">
    <%= project_tile(project) %>
    <div class="min-w-0">
      <%= link_to project.name, project_alerts_path(project), class: "block truncate text-[14px] text-ink-50 hover:underline" %>
      <div class="text-[12px] text-ink-400 truncate">
        Watching <%= alert_environments_label(project) %><% unless project.alert_rule_enabled?(:daily_digest) %> · digest is off for this app<% end %>
      </div>
    </div>
  </div>
  <div class="text-center">
    <%= switch_button_to project_notification_preference_path(project), pressed: receives_alerts,
          params: { "notification_preference[alerts_muted]" => receives_alerts }, label: "Email alerts from #{project.name}" %>
  </div>
  <div class="text-center">
    <%= switch_button_to project_notification_preference_path(project), pressed: receives_digest,
          params: { "notification_preference[digest_enabled]" => !receives_digest }, label: "Daily digest from #{project.name}" %>
  </div>
</li>
