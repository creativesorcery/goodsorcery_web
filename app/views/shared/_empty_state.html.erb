<%# locals: (title:, body: nil, action: nil) -%>
<div class="panel border-dashed px-5 sm:px-8 py-12 text-center rise">
  <div class="mx-auto w-12 h-12"><%= render "shared/sigil" %></div>
  <h2 class="font-display text-[22px] text-ink-50 mt-4"><%= title %></h2>
  <% if body %>
    <p class="text-[14px] text-ink-400 mt-2 max-w-md mx-auto"><%= body %></p>
  <% end %>
  <% if action %>
    <div class="mt-5"><%= action %></div>
  <% end %>
</div>
