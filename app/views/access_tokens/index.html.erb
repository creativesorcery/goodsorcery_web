<% provide :title, "Access tokens" %>
<% provide :nav, "access_tokens" %>
<%# A new token is on this page once; never let Turbo restore it from its snapshot cache. %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% breadcrumb Current.account.name, projects_path %>
<% breadcrumb "Access tokens" %>

<div id="access_tokens" class="px-8 py-8 max-w-3xl">
  <%= render "access_tokens/page", access_token: @access_token, created_token: @created_token %>
</div>
