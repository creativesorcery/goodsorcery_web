<%# locals: (access_token:, created_token: nil) -%>
<div class="rise">
  <div class="eyebrow">Your account</div>
  <h1 class="page-title">MCP server</h1>
  <p class="mt-2 text-[13.5px] text-ink-300">
    AI clients such as Claude Code, Codex, Cursor and VS Code can connect to Good Sorcery's MCP server to look into
    errors, uptime and performance with you. Each client needs an access token, which acts as you in one account.
  </p>
</div>

<%# One set of client tabs: the new token's snippets (create response only) replace the placeholder ones. %>
<% if created_token %>
  <%= render "access_tokens/created", token: created_token %>
<% else %>
  <%= render "access_tokens/connect" %>
<% end %>

<%= render "access_tokens/form", access_token: %>

<section class="panel mt-6 rise rise-2" aria-labelledby="access_tokens_heading">
  <div class="px-5 py-3 border-b border-paper-700 text-[11px] uppercase tracking-[.14em] text-ink-400">
    <h2 id="access_tokens_heading">Your tokens</h2>
  </div>
  <% if access_tokens.any? %>
    <ul class="divide-y divide-paper-700/70">
      <%= render partial: "access_tokens/token", collection: access_tokens, as: :token %>
    </ul>
  <% else %>
    <p class="px-5 py-6 text-[13.5px] text-ink-400">No tokens yet. Create one above to connect an AI client.</p>
  <% end %>
</section>
