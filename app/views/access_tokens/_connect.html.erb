<%# How to connect a client, before a token exists: the snippets carry a placeholder, never a token.
    The create response shows access_tokens/created in its place, so there is only ever one set of client tabs. -%>
<section id="connect_client" class="panel mt-6 p-5 rise" aria-labelledby="connect_client_heading">
  <h2 id="connect_client_heading" class="font-display text-[19px] text-ink-50">Connect a client</h2>
  <ol class="mt-3 space-y-1.5 text-[13.5px] text-ink-200">
    <li>
      <span class="font-mono text-[13px] text-iris-400 mr-1.5">1.</span>
      <%= link_to "Create an access token", "#new_access_token", class: "text-iris-300 hover:underline" %> below.
    </li>
    <li>
      <span class="font-mono text-[13px] text-iris-400 mr-1.5">2.</span>
      Paste the snippet for your client, replacing
      <span class="font-mono text-[12.5px] text-ink-100"><%= AccessTokensHelper::TOKEN_PLACEHOLDER %></span> with your token.
    </li>
  </ol>

  <%= render "access_tokens/server_url" %>
  <%= render "access_tokens/clients", token_value: AccessTokensHelper::TOKEN_PLACEHOLDER %>
</section>
