<%# locals: (token:) -%>
<%# The plaintext token, rendered only in the create response; never cache this. -%>
<section id="created_access_token" class="panel mt-6 p-5 rise border-mint-400/60" aria-labelledby="created_access_token_heading">
  <h2 id="created_access_token_heading" class="font-display text-[19px] text-ink-50">Copy your token now</h2>
  <p class="mt-1 text-[13px] text-ink-300">
    It's shown only this once. Treat it like a password: anyone with it can use
    <span class="font-semibold text-ink-100"><%= token.account.name %></span> as you, with the scopes you chose.
  </p>
  <div class="mt-3 flex flex-wrap items-center gap-2" data-controller="clipboard">
    <code class="font-mono text-[13px] bg-paper-950 border border-paper-700 rounded-lg px-3 py-1.5 text-iris-200 break-all"
          data-clipboard-target="source"><%= token.token %></code>
    <button type="button" class="btn btn-sm" data-action="clipboard#copy">Copy</button>
  </div>

  <div class="mt-5" data-controller="tabs">
    <div class="flex items-center gap-6 border-b border-paper-700" role="tablist" aria-label="AI client">
      <% AccessTokensHelper::CLIENTS.each_with_index do |(id, label), index| %>
        <button type="button" class="tab" role="tab" id="client-tab-<%= id %>" aria-selected="<%= index.zero? %>"
                aria-controls="client-<%= id %>" data-tabs-target="tab" data-action="tabs#select"><%= label %></button>
      <% end %>
    </div>
    <% AccessTokensHelper::CLIENTS.each_with_index do |(id, _label), index| %>
      <%= tag.div id: "client-#{id}", role: "tabpanel", aria: { labelledby: "client-tab-#{id}" },
            data: { tabs_target: "panel" }, class: "mt-4 space-y-3", hidden: !index.zero? do %>
        <% mcp_client_snippets(id, token.token).each do |file, text| %>
          <%= render layout: "projects/setups/snippet", locals: { label: file } do %><%= text %><% end %>
        <% end %>
        <% if id == "vscode" %>
          <p class="hint">VS Code asks for the token when it first connects and keeps it out of the file, so the file is safe to commit.</p>
        <% elsif id == "codex" %>
          <p class="hint">Codex reads the token from the <span class="font-mono"><%= AccessTokensHelper::TOKEN_VARIABLE %></span> environment variable.</p>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <p class="hint mt-4">
    The server URL is <span class="font-mono text-ink-200"><%= mcp_endpoint_url %></span>.
    Connectors in claude.ai and Claude Desktop aren't supported yet: they need an OAuth sign-in.
  </p>
</section>
