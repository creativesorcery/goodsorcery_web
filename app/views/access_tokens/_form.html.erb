<%# locals: (access_token:) -%>
<% accounts = Current.user.accounts.order(:name).to_a %>
<section class="panel mt-6 p-5 rise rise-1" aria-labelledby="new_access_token_heading">
  <h2 id="new_access_token_heading" class="font-display text-[19px] text-ink-50">Create an access token</h2>
  <%= form_with model: access_token, url: access_tokens_path, scope: :personal_access_token, id: "new_access_token",
        class: "mt-4 space-y-5" do |form| %>
    <% if access_token.errors.any? %>
      <div class="rounded-xl border border-coral-500/40 bg-coral-500/10 px-4 py-3 text-[13px] text-coral-300" role="alert">
        <%= access_token.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Name", class: "label" %>
      <%= form.text_field :name, class: "field", required: true, maxlength: 60, autocomplete: "off",
            placeholder: "Claude Code on my laptop" %>
      <p class="hint">Name it after the client and machine, so you know which one to revoke.</p>
    </div>

    <% if accounts.size > 1 %>
      <div>
        <%= form.label :account_id, "Account", class: "label" %>
        <%= form.select :account_id, accounts.map { |account| [ account.name, account.id ] }, {}, class: "field max-w-[20rem]" %>
        <p class="hint">A token reads and triages one account.</p>
      </div>
    <% end %>

    <fieldset>
      <legend class="label">Scopes</legend>
      <div class="space-y-3">
        <% AccessTokensHelper::SCOPE_DESCRIPTIONS.each do |scope, description| %>
          <label class="flex items-start gap-2.5 text-[13.5px] text-ink-100">
            <% if scope == "read" %>
              <input type="checkbox" checked disabled class="mt-1 accent-iris-300" aria-describedby="scope_read_hint">
            <% else %>
              <%= check_box_tag "personal_access_token[scopes][]", scope, access_token.scope?(scope), id: "scope_#{scope}",
                    class: "mt-1 accent-iris-300", aria: { describedby: "scope_#{scope}_hint" } %>
            <% end %>
            <span>
              <span class="font-semibold"><%= AccessTokensHelper::SCOPE_LABELS.fetch(scope) %></span>
              <span id="scope_<%= scope %>_hint" class="block text-[12.5px] text-ink-400"><%= description %></span>
              <% if scope == "request_data" %>
                <span class="block mt-1 text-[12.5px] text-coral-300"><%= AccessTokensHelper::REQUEST_DATA_WARNING %></span>
              <% end %>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div>
      <%= form.label :expires_in, "Expires", class: "label" %>
      <%= form.select :expires_in, access_token_expiry_options, { selected: PersonalAccessToken::DEFAULT_EXPIRY }, class: "field max-w-[12rem]" %>
    </div>

    <div class="pt-1">
      <%= form.submit "Create token", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
