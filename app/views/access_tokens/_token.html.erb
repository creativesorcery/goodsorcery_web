<%# locals: (token:) -%>
<% activities = token_activities.fetch(token.id, []) %>
<li id="<%= dom_id(token) %>" class="px-5 py-4 <%= 'opacity-70' unless token.active? %>">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[14px] text-ink-50 font-semibold"><%= token.name %></span>
        <%= access_token_status_chip(token) %>
        <%= access_token_scope_chips(token) %>
      </div>
      <div class="mt-1 text-[12px] text-ink-400">
        <span class="font-mono text-ink-200"><%= token.masked_token %></span>
        · <%= token.account.name %>
        · Created <%= token.created_at.to_date.to_fs(:long) %>
        · <%= access_token_last_used(token) %>
        · <%= access_token_expiry(token) %>
      </div>
    </div>
    <% if token.active? %>
      <%= button_to "Revoke", access_token_path(token), method: :delete, class: "btn btn-sm", form_class: "shrink-0",
            aria: { label: "Revoke #{token.name}" },
            data: { turbo_confirm: "Revoke #{token.name}? Clients using it lose access at once." } %>
    <% end %>
  </div>
  <% if activities.any? %>
    <details class="mt-2 text-[12.5px]">
      <summary class="cursor-pointer text-ink-300 hover:text-ink-100">Recent activity (<%= activities.size %>)</summary>
      <ul class="mt-2 space-y-1 pl-4">
        <% activities.each do |activity| %>
          <li class="text-ink-300">
            <%= activity.label %> <%= access_token_activity_issues(activity, activity_issues) %>
            <span class="text-ink-400" title="<%= clock_label(activity.created_at) %>">· <%= time_ago_compact(activity.created_at) %></span>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
</li>
