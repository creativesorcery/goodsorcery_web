# Copy to .env for local development: cp .env.example .env
# .env is git-ignored. Development needs none of these; uncomment only what you want to change.
# Loaded by the dotenv gem in development (not test or production), by foreman for bin/dev,
# and by bin/send_test_event.
# Production reads real environment variables: see "Environment variables" in README.md.

# --- Server ---
# PORT=3000
# RAILS_MAX_THREADS=5

# --- Database (defaults to the local goodsorcery_web_development database) ---
# DATABASE_URL=postgres://localhost/goodsorcery_web_development

# --- Sign-up ---
# Open sign-up beyond the first account.
# GOODSORCERY_ENABLE_SIGNUPS=1
# Close sign-up entirely, even before the first account exists (overrides ENABLE).
# GOODSORCERY_DISABLE_SIGNUPS=1
# Legal pages the sign-up page links to ("By signing up you agree to ..."); http(s) only.
# Leave both unset and the sign-up page shows no agreement sentence.
# GOODSORCERY_TERMS_URL=https://example.com/terms
# GOODSORCERY_PRIVACY_URL=https://example.com/privacy

# --- Instance ---
# Endpoint shown in the setup page's install snippets (defaults to the request's base URL).
# GOODSORCERY_PUBLIC_URL=http://localhost:3000
# Show "Hosted" instead of "Self-hosted" and drop the endpoint line from install snippets.
# GOODSORCERY_HOSTED=true
# GOODSORCERY_MAIL_FROM="Good Sorcery <no-reply@localhost>"
# GOODSORCERY_DOCS_URL=https://github.com/creativesorcery/goodsorcery_web/tree/main/docs

# --- bin/send_test_event and bin/send_test_apm (and the gem, when the app reports to itself) ---
# Get a key with: bin/rails runner 'puts Project.find_by!(slug: "storefront").api_keys.find_by!(environment: "staging").token'
# GOODSORCERY_API_KEY=
# GOODSORCERY_ENDPOINT=http://localhost:3000   # GOODSORCERY_HOST is still read as a fallback
