# Secrets for config/deploy.yml, read from the environment. Nothing here is a
# raw secret, so this file is safe for a public repo. In CI they come from the
# GitHub "production" environment; locally, export them from your password
# manager first (see docs/DEPLOYMENT.md).
#
# To pull them from a password manager instead, for example 1Password:
# SECRETS=$(kamal secrets fetch --adapter 1password --account your-account --from Vault/Item SECRET_KEY_BASE ...)
# SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE ${SECRETS})

KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

SECRET_KEY_BASE=$SECRET_KEY_BASE
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
GOODSORCERY_WEB_DATABASE_PASSWORD=$GOODSORCERY_WEB_DATABASE_PASSWORD
POSTMARK_API_TOKEN=$POSTMARK_API_TOKEN
# Optional: the ingest key Good Sorcery uses to report its own errors.
GOODSORCERY_API_KEY=$GOODSORCERY_API_KEY

# Only needed when booting the tunnel accessory (bin/kamal setup or
# bin/kamal accessory boot tunnel), so CI doesn't need it.
CLOUDFLARE_TUNNEL_TOKEN=$CLOUDFLARE_TUNNEL_TOKEN
